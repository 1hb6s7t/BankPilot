{
  "name": "bankpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web,worker \"pnpm dev:api\" \"pnpm dev:web\" \"pnpm dev:worker\"",
    "dev:api": "tsx watch --env-file=.env apps/api/src/main.ts",
    "dev:web": "vite apps/web --host 127.0.0.1 --port 5178",
    "dev:worker": "tsx watch --env-file=.env apps/worker/src/main.ts",
    "demo": "concurrently -k -n api,web,worker \"pnpm demo:api\" \"pnpm dev:web\" \"pnpm demo:worker\"",
    "demo:api": "tsx --env-file=.env apps/api/src/main.ts",
    "demo:worker": "tsx --env-file=.env apps/worker/src/main.ts",
    "db:up": "docker compose up -d --wait",
    "setup": "tsx --env-file=.env scripts/setup.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:isolated": "tsx scripts/test-isolated.ts",
    "test:e2e": "playwright test",
    "test:e2e:g8h": "playwright test --config playwright.g8h.config.ts",
    "test:e2e:g8i": "playwright test --config playwright.g8i.config.ts",
    "test:e2e:g8j": "playwright test --config playwright.g8j.config.ts",
    "test:e2e:g8k": "playwright test --config playwright.g8k.config.ts",
    "test:e2e:g8l": "playwright test --config playwright.g8l.config.ts",
    "test:e2e:g8m": "playwright test --config playwright.g8m.config.ts",
    "test:e2e:g8n:live": "playwright test --config playwright.g8n-live.config.ts",
    "test:db-faults:g8i": "vitest run --config vitest.g8i.config.ts",
    "test:db-faults:g8j": "vitest run --config vitest.g8j.config.ts",
    "delivery:export": "node scripts/delivery/export.mjs",
    "delivery:verify": "node scripts/delivery/verify.mjs",
    "delivery:prepare": "node scripts/delivery/prepare.mjs",
    "delivery:start": "node scripts/delivery/start.mjs",
    "delivery:stop": "node scripts/delivery/start.mjs --stop",
    "delivery:destroy": "node scripts/delivery/start.mjs --destroy",
    "eval:scripted": "tsx --env-file=.env scripts/evaluate-model.ts --mode scripted --limit 12 --concurrency 2",
    "eval:live": "tsx --env-file=.env scripts/evaluate-model.ts --mode live --limit 12 --concurrency 2",
    "eval:management:scripted": "tsx --env-file=.env scripts/evaluate-model.ts --suite management --mode scripted --concurrency 2",
    "eval:management:live": "tsx --env-file=.env scripts/evaluate-model.ts --suite management --mode live --concurrency 2",
    "build": "vite build apps/web",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "eval:phase4:scripted": "tsx --env-file=.env scripts/evaluate-model.ts --suite phase4 --mode scripted --concurrency 2",
    "eval:phase4:live": "tsx --env-file=.env scripts/evaluate-model.ts --suite phase4 --mode live --concurrency 2",
    "eval:ablation:scripted": "tsx --env-file=.env scripts/evaluate-ablation.ts --mode scripted --selection all",
    "eval:ablation:live": "tsx --env-file=.env scripts/evaluate-ablation.ts --mode live --selection pilot",
    "eval:g6:regression": "tsx --env-file=.env scripts/evaluate-g6.ts --known-regression --mode scripted --selection all",
    "eval:g6:scripted": "tsx --env-file=.env scripts/evaluate-g6.ts --mode scripted --selection all",
    "eval:g6:live": "tsx --env-file=.env scripts/evaluate-g6.ts --mode live --selection pilot --topology production",
    "eval:g6:postfix": "tsx --env-file=.env scripts/evaluate-g6.ts --postfix --mode scripted --selection all",
    "eval:g7:live": "tsx --env-file=.env scripts/evaluate-g7.ts --mode live --selection pilot",
    "eval:g7:scripted": "tsx --env-file=.env scripts/evaluate-g7.ts --mode scripted --selection all"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.30",
    "@hono/node-server": "2.1.5",
    "@langchain/core": "1.2.20",
    "@langchain/langgraph": "1.5.2",
    "@langchain/langgraph-checkpoint-postgres": "1.1.2",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "better-auth": "1.7.12",
    "hono": "4.13.13",
    "lucide-react": "1.61.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7"
  }
}
